# Copy to .env and fill in what you need. Blank values fall back to the defaults noted here.

# --- Model providers ---------------------------------------------------------
# Both are required: the claim checker runs on a different provider than the copywriter.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Model routing (optional) ------------------------------------------------
# Routing profile file. Default: the packaged budget profile.
MODELS_CONFIG_PATH=
# Override one role as provider:model-id. Roles: researcher, strategist, copywriter,
# claim_checker, designer, judge.
MODEL__RESEARCHER=
MODEL__STRATEGIST=
MODEL__COPYWRITER=
MODEL__CLAIM_CHECKER=
MODEL__DESIGNER=
MODEL__JUDGE=
# Override the profile's `default` entry: openai or anthropic, plus the matching model ID.
LLM_PROVIDER=
OPENAI_MODEL=
ANTHROPIC_MODEL=

# --- Request behavior (optional) ---------------------------------------------
# Per-request timeout in seconds (default 300) and SDK retries (default 3).
LLM_TIMEOUT_SECONDS=
LLM_MAX_RETRIES=

# --- Research tools (optional) -----------------------------------------------
# Enables the web_search tool (Tavily).
TAVILY_API_KEY=
# On-disk tool-result cache directory (off when blank) and its TTL in hours (default 24).
TOOL_CACHE_DIR=
TOOL_CACHE_TTL_HOURS=
# Custom source-quality rules (default: the packaged config/source_quality.yaml).
SOURCE_QUALITY_PATH=

# --- Image generation (optional) ---------------------------------------------
# Generate images from the designer's prompts (default false).
ENABLE_IMAGES=

# --- Observability (optional) ------------------------------------------------
# Tracing turns on only when both keys are set. Base URL default: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# --- Logging (optional) ------------------------------------------------------
# DEBUG, INFO (default), WARNING, or ERROR.
LOG_LEVEL=
